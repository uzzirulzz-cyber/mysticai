{
  "builds": [
    {
      "src": "api/build.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/build",
      "destination": "/api/build.js"
    }
  ]
}
